{
  "name": "manuscript-formatter-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./app/static/tailwind.css --minify",
    "dev:css": "tailwindcss -i ./src/styles/tailwind.css -o ./app/static/tailwind.css --watch",
    "build": "npm run build:css && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && cp -r app dist/ 2>/dev/null || :",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "cors": "^2.8.5",
    "docx": "^9.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide": "^1.16.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.21",
    "autoprefixer": "^10.4.14"
  }
}
